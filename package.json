{
  "name": "new-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node --import tsx scripts/prerender.tsx",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --import tsx scripts/graph.test.ts",
    "test:browser": "playwright test",
    "format": "prettier --write src scripts tests *.ts *.js *.json index.html .prettierrc.json .openai/hosting.json",
    "format:check": "prettier --check src scripts tests *.ts *.js *.json index.html .prettierrc.json .openai/hosting.json"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.6.1",
    "@tailwindcss/vite": "^4.3.5",
    "gsap": "^3.15.1",
    "lucide-react": "^1.70.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.5",
    "three": "^0.185.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1"
  }
}
